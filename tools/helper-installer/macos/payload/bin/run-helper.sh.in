#!/bin/sh
#
# Launched by launchd, as the logged-in user, and nothing else.
#
# This two-line indirection exists for one reason: launchd does not expand
# variables in a job's plist. An agent in /Library/LaunchAgents is one file
# shared by every account on the machine, so a StandardOutPath written into it
# either names one user's home — wrong for everybody else — or names a shared
# location, which would put one person's helper log where another person can
# read it. Moving the redirection into a program that launchd starts *as the
# user* makes $HOME mean the right thing on every account without the plist
# having to know who is logged in.
#
# The log is append-only and holds no credential: the helper redacts tokens
# before it prints, and its startup line is a version number and a file path.
# If the log cannot be opened the helper still runs — a job that refuses to
# start because it could not write a log file would be a worse failure than a
# silent one.
#
# __PREFIX__ is substituted at build time by tools/helper-installer/build-macos-pkg.sh.

PREFIX="__PREFIX__"
LOG_DIR="${HOME}/Library/Logs/whatsapp-sales-ai-copilot"
LOG_FILE="${LOG_DIR}/helper.log"

if /bin/mkdir -p "$LOG_DIR" 2>/dev/null && : >>"$LOG_FILE" 2>/dev/null; then
	/bin/chmod 700 "$LOG_DIR" 2>/dev/null
	/bin/chmod 600 "$LOG_FILE" 2>/dev/null
	# exec, so launchd's KeepAlive is watching the helper process itself and
	# not a shell sitting in front of it.
	exec "${PREFIX}/runtime/bin/node" "${PREFIX}/helper/siwc-helper.js" >>"$LOG_FILE" 2>&1
fi

exec "${PREFIX}/runtime/bin/node" "${PREFIX}/helper/siwc-helper.js" >/dev/null 2>&1
